{
  "name": "our-story",
  "version": "0.1.0",
  "private": true,
  "description": "Workspaces root. Apps live in apps/*; shared packages in packages/*.",
  "scripts": {
    "web": "pnpm --filter @our-story/web",
    "mobile": "pnpm --filter @our-story/mobile",
    "dev": "pnpm --filter @our-story/web run dev",
    "build": "pnpm --filter @our-story/web run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:migrate": "pnpm --filter @our-story/web run db:migrate",
    "db:seed": "pnpm --filter @our-story/web run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.4"
}
