# Neon Postgres connection strings.
#
# DATABASE_URL is the pooled connection (used by the app at runtime).
# DATABASE_URL_DIRECT is the unpooled / direct connection (used by Prisma
# Migrate, which can't run against a pgbouncer-style pool). On Neon, copy
# both from the project dashboard — the pooled URL has `-pooler` in the
# hostname.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ourstory?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/ourstory?sslmode=require"

# Upstash Redis (rate limiting). Both REST URL and token come from the
# Upstash dashboard. Used by auth + write-endpoint limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OAuth (filled in commit 9). Leave blank during local web auth bring-up.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public site URL for OAuth callbacks + absolute links. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
