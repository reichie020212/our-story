# Neon Postgres connection strings.
#
# DATABASE_URL is the pooled connection (used by the app at runtime).
# DATABASE_URL_DIRECT is the unpooled / direct connection (used by Prisma
# Migrate, which can't run against a pgbouncer-style pool). On Neon, copy
# both from the project dashboard — the pooled URL has `-pooler` in the
# hostname.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ourstory?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/ourstory?sslmode=require"

# Upstash Redis (rate limiting). Both REST URL and token come from the
# Upstash dashboard. Used by auth + write-endpoint limits. The app
# falls back to a no-op limiter when these are blank.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OAuth — register apps with each provider, then paste the credentials
# here. Callbacks should be ${NEXT_PUBLIC_SITE_URL}/api/v1/auth/oauth/
# {google|github}/callback. /start returns 503 oauth_not_configured
# when these are blank, so dev without OAuth still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public site URL for OAuth callbacks + absolute links. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mobile auth — RS256 key pair. Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then paste each PEM as-is (multi-line, between double quotes). dotenv
# parses multi-line quoted values cleanly. Single-line form with literal
# "\n" separators also works, but is brittle if any one separator gets
# mangled in copy-paste — prefer multi-line.
#
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIEv...
# ...
# -----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBI...
# -----END PUBLIC KEY-----"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
