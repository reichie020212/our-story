# Neon Postgres connection strings.
#
# DATABASE_URL is the pooled connection (used by the app at runtime).
# DATABASE_URL_DIRECT is the unpooled / direct connection (used by Prisma
# Migrate, which can't run against a pgbouncer-style pool). On Neon, copy
# both from the project dashboard — the pooled URL has `-pooler` in the
# hostname.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ourstory?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/ourstory?sslmode=require"

# Upstash Redis (rate limiting). Both REST URL and token come from the
# Upstash dashboard. Used by auth + write-endpoint limits. The app
# falls back to a no-op limiter when these are blank.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OAuth — register apps with each provider, then paste the credentials
# here. Callbacks should be ${NEXT_PUBLIC_SITE_URL}/api/v1/auth/oauth/
# {google|github}/callback. /start returns 503 oauth_not_configured
# when these are blank, so dev without OAuth still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public site URL for OAuth callbacks + absolute links. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Superadmin bootstrap. On every deploy (and on `pnpm db:seed` /
# `pnpm db:ensure-superadmin` in dev) the app upserts ONE superadmin account
# from these vars: role=admin, undemotable, email pre-verified. A superadmin's
# role can't be changed, and only a superadmin can grant/revoke the flag (never
# on themselves). Leave EMAIL/PASSWORD blank to skip creating one (the bootstrap
# logs a warning and continues). Fill them in to enable the account.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Superadmin"

# Ad slots (leaderboard, in-feed, footer) are placeholder reservations for the
# eventual ad network. They only render when this is exactly "true". Leave it
# unset/blank in production so the striped "AD" boxes stay hidden until real ad
# units are wired in; set it to "true" locally to preview the layout with ads.
NEXT_PUBLIC_ADS_ENABLED=""

# Transactional email (Resend). Used by signup → verification flow.
# Sign up at https://resend.com, verify a sending domain, drop the API
# key here. Without it, the app logs verification links to the server
# console so local dev still works.
RESEND_API_KEY=""
# Must be a verified sender on the API key's Resend domain.
# Example: "OurStory <noreply@your-domain.com>"
RESEND_FROM=""

# Mobile auth — RS256 key pair. Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then paste each PEM as-is (multi-line, between double quotes). dotenv
# parses multi-line quoted values cleanly. Single-line form with literal
# "\n" separators also works, but is brittle if any one separator gets
# mangled in copy-paste — prefer multi-line.
#
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIEv...
# ...
# -----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBI...
# -----END PUBLIC KEY-----"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
