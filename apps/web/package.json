{
  "name": "@our-story/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && tsx scripts/ensure-superadmin.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run __tests__/auth-flow.integration.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure-superadmin": "tsx scripts/ensure-superadmin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@our-story/api-types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "arctic": "^3.7.0",
    "jose": "^6.2.3",
    "next": "~15.4.11",
    "nodemailer": "^8.0.10",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "~15.4.11",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
