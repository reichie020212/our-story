// Prisma schema for OurStory — see CLAUDE_CODE_PROMPT.md §4 + memory:
// project_ourstory_backend_decisions for the load-bearing decisions
// (image features deferred, body is paragraphs-only, Lucia v3 sessions,
// argon2id passwords, Neon Postgres + connection pooling).

generator client {
  provider = "prisma-client-js"
}

// Connection URLs live in prisma.config.ts in Prisma 7. The provider
// stays here so the schema engine and code generator know the dialect.
datasource db {
  provider = "postgresql"
}

enum Genre {
  literary
  fantasy
  scifi
  romance
  horror
  mystery
  memoir
  poetry
}

enum StoryLength {
  flash
  short
  novelette
  novella
}

enum StoryStatus {
  draft
  pending_review
  published
  rejected
  unlisted
  private
}

enum OAuthProvider {
  google
  github
}

enum UserRole {
  user
  admin
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?        @map("password_hash")
  name            String
  handle          String         @unique
  initial         String         @db.VarChar(2)
  bio             String?
  avatarUrl       String?        @map("avatar_url")
  oauthProvider   OAuthProvider? @map("oauth_provider")
  oauthId         String?        @map("oauth_id")
  // Null until the user clicks the verification link sent at signup.
  // OAuth signups set this immediately (provider already proved email
  // control). Unverified users can't sign in.
  emailVerifiedAt DateTime?      @map("email_verified_at")
  // Authorization role. `admin` can toggle the approval gate, review the
  // pending-story queue, and promote/demote other users. Defaults to `user`.
  role            UserRole       @default(user)
  // The bootstrapped superadmin (created from SUPERADMIN_* env vars). A
  // superadmin is always an admin too, but its role can't be demoted and the
  // flag can only be changed by a superadmin (and never unset on oneself).
  isSuperadmin    Boolean        @default(false) @map("is_superadmin")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  sessions           Session[]
  stories            Story[]                  @relation("StoryAuthor")
  reviewedStories    Story[]                  @relation("StoryReviewer")
  likes              Like[]
  bookmarks          Bookmark[]
  mobileTokens       MobileRefreshToken[]
  verificationTokens EmailVerificationToken[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

// Global, runtime-toggleable app configuration. A single row (id "global")
// holds platform-wide flags. `approvalRequired` gates story publishing: when
// true, non-admin authors submit stories for admin review instead of
// publishing directly. Defaults to false (direct publish, the v1 behavior).
model AppSetting {
  id               String   @id @default("global")
  approvalRequired Boolean  @default(false) @map("approval_required")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedById      String?  @map("updated_by_id")

  @@map("app_settings")
}

// Single-use email verification tokens. Raw token is handed to the user
// in the verification link; only the sha256 hash is stored, so a
// leaked DB snapshot can't be replayed. consumedAt marks success;
// when a fresh token is issued, prior unconsumed rows for the user are
// deleted so only the latest link works.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Mobile refresh tokens (opaque, sha256-hashed at rest). The web uses
// the cookie Session table; mobile clients exchange these for short-
// lived RS256 access JWTs via /api/v1/auth/mobile/refresh.
model MobileRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mobile_refresh_tokens")
}

// Lucia v3 session shape: id (string PK), userId, expiresAt.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Story {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  authorId             String                   @map("author_id")
  title                String
  synopsis             String
  // Heterogeneous-by-design but image-block-free in v1: a Json string[].
  // Kept as Json (not String[]) so a future image-block re-introduction
  // doesn't require a migration.
  body                 Json
  genre                Genre
  length               StoryLength
  tags                 String[]
  status               StoryStatus              @default(draft)
  featured             Boolean                  @default(false)
  publishedAt          DateTime?                @map("published_at")
  // Approval workflow audit trail. Set when a non-admin author submits the
  // story for review (status -> pending_review). reviewedAt/reviewedById/
  // rejectionReason are filled by the admin who approves or rejects it.
  submittedForReviewAt DateTime?                @map("submitted_for_review_at")
  reviewedAt           DateTime?                @map("reviewed_at")
  reviewedById         String?                  @map("reviewed_by_id")
  rejectionReason      String?                  @map("rejection_reason")
  minutes              Int                      @default(0)
  viewCount            Int                      @default(0) @map("view_count")
  likeCount            Int                      @default(0) @map("like_count")
  // Soft-delete: rows with deletedAt set are excluded from public lists
  // but kept in the table so likes/bookmarks/views stay referentially
  // sound. Hard-delete is left to a periodic GC, not the API.
  deletedAt            DateTime?                @map("deleted_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  // Postgres-generated tsvector for full-text search on title (A) +
  // synopsis (B) + tags (C). Maintained by the database via STORED
  // GENERATED column; the app never writes to it directly. The matching
  // GIN index is declared in the migration since Prisma can't index an
  // Unsupported type via @@index.
  searchVector         Unsupported("tsvector")? @map("search_vector")

  author    User       @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer  User?      @relation("StoryReviewer", fields: [reviewedById], references: [id])
  likes     Like[]
  bookmarks Bookmark[]
  views     View[]

  @@index([authorId])
  @@index([status, publishedAt])
  @@index([status, submittedForReviewAt])
  @@index([genre])
  @@index([featured])
  @@index([deletedAt])
  @@map("stories")
}

model Like {
  userId    String   @map("user_id")
  storyId   String   @map("story_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId])
  @@map("likes")
}

model Bookmark {
  userId    String   @map("user_id")
  storyId   String   @map("story_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId])
  @@map("bookmarks")
}

// View dedup: sessionHash = hash(ip + ua + day_bucket). The day bucket
// makes the hash naturally roll over every 24h, so a unique constraint
// on (storyId, sessionHash) blocks re-counts inside the window without
// a separate cleanup job.
model View {
  id          String   @id @default(cuid())
  storyId     String   @map("story_id")
  sessionHash String   @map("session_hash")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sessionHash])
  @@index([storyId, viewedAt])
  @@map("views")
}
